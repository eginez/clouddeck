[sso-session corp]
sso_start_url = https://corp.awsapps.com/start
sso_region = us-east-1

[profile base]
sso_session = corp
sso_account_id = 111111111111
sso_role_name = Admin

[profile base-dev]
role_arn = arn:aws:iam::222222222222:role/Developer
source_profile = base
region = us-west-2

[profile shared-dev]
role_arn = arn:aws:iam::333333333333:role/Auditor
source_profile = shared

[profile chain-a]
role_arn = arn:aws:iam::444444444444:role/A
source_profile = chain-b

[profile chain-b]
role_arn = arn:aws:iam::555555555555:role/B
source_profile = chain-a

[profile missing-source]
role_arn = arn:aws:iam::666666666666:role/C
source_profile = nowhere
